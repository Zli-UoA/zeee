{
  "name": "zeee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:celld": "VOID_CLOUDFLARE_DEPLOY_BUILD=1 CELLD_BUILD=1 NODE_ENV=production vp build",
    "watch:celld": "VOID_CLOUDFLARE_DEPLOY_BUILD=1 CELLD_BUILD=1 NODE_ENV=production vp build --watch",
    "dev:celld": "pnpm build:celld && concurrently -k -n vite,celld -c blue,green \"pnpm watch:celld\" \"CELLD_ESBUILD=./node_modules/.bin/esbuild celld dev dist\"",
    "check": "vp check && tsc --noEmit",
    "spike": "pnpm build:celld && node scripts/spike-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.16.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@void/react": "^1.3.0",
    "codemirror": "^6.0.2",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "catalog:",
    "void": "1.3.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.16.1"
}
